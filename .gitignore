app/ios/Pods/
app/ios/.symlinks/
app/android/.gradle/
app/android/local.properties
app/*.iml

# server/static is a COMMITTED build artifact (the Flutter web bundle).
# Deploys copy it straight into the image, which keeps them fast and
# reproducible. Regenerate with `make web`.

.DS_Store
